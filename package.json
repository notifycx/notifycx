{
  "name": "notifycx",
  "version": "1.2.0",
  "description": "Official Node/TypeScript client for the Notify transactional email API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsx --test src/index.test.ts",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "notify",
    "notifycx",
    "email",
    "transactional-email",
    "email-api",
    "typescript",
    "nodejs"
  ],
  "files": [
    "dist",
    "readme.md"
  ],
  "homepage": "https://notify.cx/docs/how-to-use-notify-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notifycx/notifycx.git"
  },
  "bugs": {
    "url": "https://github.com/notifycx/notifycx/issues"
  },
  "author": "notify.cx",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "tsup": "^8.0.1"
  }
}
